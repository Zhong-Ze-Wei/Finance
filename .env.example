# AI 模型 API 配置

# 小米 Mimo API
VITE_MIMO_BASE_URL=/api/llm
VITE_MIMO_API_KEY=your_mimo_api_key
VITE_MIMO_MODEL=mimo-v2-flash

# AIPing API (DeepSeek, GLM, MiniMax, Qwen)
VITE_AIPING_BASE_URL=https://www.aiping.cn/api/v1
VITE_AIPING_API_KEY=your_aiping_api_key

# EmailJS 邮件配置
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_ALERT_EMAIL=your_email@example.com

# Tavily API (新闻全文搜索)
VITE_TAVILY_API_KEY=your_tavily_api_key

# MySQL 数据库配置（Docker）
MYSQL_ROOT_PASSWORD=crypto2024
MYSQL_USER=crypto_user
MYSQL_PASSWORD=crypto_pass
